<Project Sdk="Microsoft.NET.Sdk">                                        <!-- standard .NET project -->
  <PropertyGroup>                                                       <!-- build settings -->
    <OutputType>WinExe</OutputType>                                     <!-- Windows program, no console window -->
    <TargetFramework>net8.0-windows</TargetFramework>                   <!-- runs on the .NET 8 Desktop Runtime -->
    <UseWindowsForms>true</UseWindowsForms>                             <!-- the window is WinForms -->
    <Nullable>enable</Nullable>                                         <!-- compiler warns about possible nulls -->
    <ImplicitUsings>enable</ImplicitUsings>                             <!-- System, System.IO, System.Linq, WinForms etc. are imported automatically -->
    <AssemblyName>IconKeeper</AssemblyName>                             <!-- the exe is IconKeeper.exe -->
    <RootNamespace>IconKeeper</RootNamespace>                           <!-- code namespace -->
    <Version>1.1.0</Version>                                            <!-- file version; V1R1 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>       <!-- DPI aware, so screen sizes are real pixels -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>         <!-- English only, no extra language folders -->
  </PropertyGroup>                                                      <!-- end of build settings -->
</Project>                                                              <!-- end of project -->
